{% doc %}
  Renders the shared GENETIX call-to-action as a link or form button.

  @param {string} label - Button label.
  @param {string} [link] - Link destination when rendering an anchor.
  @param {color} [background] - Button background color.
  @param {color} [color] - Button text and icon color.
  @param {boolean} [show_arrow] - Whether to display the up-right arrow.
  @param {boolean} [open_new_tab] - Whether an anchor opens in a new tab.
  @param {string} [tag] - Use `button` for a form control; defaults to `a`.
  @param {string} [button_type] - Native button type; defaults to `button`.
  @param {boolean} [disabled] - Disables a rendered button.
  @param {string} [price] - Optional price appended to the label.
  @param {boolean} [show_price] - Whether to append the optional price.
  @param {string} [form_id] - Optional associated form ID.
  @param {string} [data_action] - Optional purchase action identifier.
  @param {string} [base_label] - Available-state label used by product interactions.
  @param {string} [class] - Additional CSS class names.

  @example
  {% render 'genetix-button', label: 'Shop now', link: product.url, show_arrow: true %}
{% enddoc %}

{% liquid
  assign element = tag | default: 'a'
  assign native_type = button_type | default: 'button'
%}

{% if element == 'button' %}
  <button
    class="genetix-button{% if class != blank %} {{ class }}{% endif %}"
    type="{{ native_type }}"
    style="--genetix-button-bg:{{ background | default: '#153640' }};--genetix-button-color:{{ color | default: '#ffffff' }};"
    {% if form_id != blank %}form="{{ form_id }}"{% endif %}
    {% if data_action != blank %}data-product-submit="{{ data_action }}" data-base-label="{{ base_label | default: label | escape }}"{% endif %}
    {% if disabled %}disabled{% endif %}
  >
    <span data-button-label>{{ label | escape }}{% if price != blank and show_price != false %} — <span data-button-price>{{ price }}</span>{% endif %}</span>
    {% if show_arrow %}
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg>
    {% endif %}
  </button>
{% else %}
  <a
    class="genetix-button{% if class != blank %} {{ class }}{% endif %}"
    {% if link != blank %}href="{{ link }}"{% else %}role="link" aria-disabled="true"{% endif %}
    {% if open_new_tab and link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
    style="--genetix-button-bg:{{ background | default: '#153640' }};--genetix-button-color:{{ color | default: '#ffffff' }};"
  >
    <span>{{ label | escape }}</span>
    {% if show_arrow %}
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg>
    {% endif %}
  </a>
{% endif %}

{% stylesheet %}
  .genetix-button {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 46px;
    padding: 10px 14px 10px 20px;
    border: 1px solid var(--genetix-button-bg);
    border-radius: 0;
    background: var(--genetix-button-bg);
    color: var(--genetix-button-color);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    overflow: hidden;
  }

  .genetix-button::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 25%,
      rgb(255 255 255 / 0.08) 38%,
      rgb(255 255 255 / 0.72) 50%,
      rgb(255 255 255 / 0.08) 62%,
      transparent 75%
    );
    content: '';
    pointer-events: none;
    transform: translateX(-125%);
  }

  .genetix-button > span,
  .genetix-button > svg {
    position: relative;
    z-index: 1;
  }

  .genetix-button svg {
    width: 22px;
    height: 22px;
    flex: none;
  }

  .genetix-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .genetix-button[aria-disabled='true'],
  .genetix-button:disabled {
    opacity: 0.65;
    cursor: default;
  }

  @media (hover: hover) {
    .genetix-button:not([aria-disabled='true']):not(:disabled):hover::before {
      transform: translateX(125%);
      transition: transform 650ms ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .genetix-button::before {
      display: none;
    }
  }
{% endstylesheet %}
