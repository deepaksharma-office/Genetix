{% comment %}
  A standards statement paired with a two-by-two grid of merchant-configurable trust points.
  @example
  Add the GENETIX icon text section to the home page and configure four benefit blocks.
{% endcomment %}

{{ 'genetix-base.css' | asset_url | stylesheet_tag }}
{{ 'genetix-icon-text.css' | asset_url | stylesheet_tag }}

<section
  class="genetix genetix-icon-text"
  style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-icon:{{ section.settings.icon_size }}px;--gx-icon-wrap-bg:{{ section.settings.icon_background }};--gx-icon-text-muted:{{ section.settings.muted_color }};--gx-icon-text-line:{{ section.settings.line_color }};--gx-icon-text-card-bg:{{ section.settings.card_background }};--gx-icon-text-card-color:{{ section.settings.card_text_color }};--gx-pt:{{ section.settings.padding_top }}px;--gx-pb:{{ section.settings.padding_bottom }}px;--gx-pt-mobile:{{ section.settings.padding_top }}px;--gx-pb-mobile:{{ section.settings.padding_bottom }}px;"
>
  <div class="genetix__inner genetix-icon-text__inner">
    <div class="genetix-icon-text__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="genetix-icon-text__statement rte custom_gradient_style ">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="genetix-icon-text__items">
      {% for block in section.blocks %}
        {% unless block.type == '@app' %}
        <article class="genetix-icon-text__item" {{ block.shopify_attributes }}>
          <div class="genetix-icon-text__icon custom_gradient_style ">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 180
                | image_tag: widths: '80, 120, 180', sizes: '80px', loading: 'lazy', alt: ''
              }}
            {% else %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="8" />
                <path d="M8 12h8M12 8v8" />
              </svg>
            {% endif %}
          </div>
          {% if block.settings.heading != blank %}
            <h3>{{ block.settings.heading | escape }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text | escape }}</p>
          {% endif %}
          {% if block.settings.link != blank and block.settings.link_label != blank %}
            <a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {% endif %}
        </article>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
  {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
</section>

{% schema %}
{
  "name": "GENETIX icon text",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE GENETIX STANDARD" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Formulating Through\nPure Biochemistry" },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>At Genetix Peptides, we believe in formulating through pure biochemistry in an industry heavily crowded by ‘more is better’ marketing. We refuse to chase deceptive percentages. Every formulation we engineer is scientifically balanced at the exact, optimal ratios required to heal, restore, and revitalize the skin—ensuring maximum cellular absorption without causing localized harm. Because while more sounds better, true science knows exactly what works.</p>" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 40, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#153640" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#173c48" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#71868d" },
    { "type": "color", "id": "line_color", "label": "Divider lines", "default": "#dce7eb" },
    { "type": "color", "id": "card_background", "label": "Statement background", "default": "#153f48" },
    { "type": "color", "id": "card_text_color", "label": "Statement text", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 52 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom icon" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quality first" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "A considered approach to every detail." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GENETIX icon text",
      "blocks": [
        { "type": "item", "settings": { "heading": "Cruelty free", "text": "A considered approach to care, without unnecessary compromises." } },
        { "type": "item", "settings": { "heading": "Laboratory Tested", "text": "A focus on quality, consistency, and the details of the formula." } },
        { "type": "item", "settings": { "heading": "Manufactured in an FDA Registered Facility", "text": "Manufactured with considered standards." } },
        { "type": "item", "settings": { "heading": "Made in the USA", "text": "Produced in the United States. Refined care, down to the details." } }
      ]
    }
  ]
}
{% endschema %}
