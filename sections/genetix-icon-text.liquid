{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-icon-text.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix-icon-text" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-icon:{{ section.settings.icon_size }}px"><div class="genetix__inner">
  <div class="genetix-icon-text__intro"><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2>{{ section.settings.text }}</div>
  <div class="genetix-icon-text__items">{% for block in section.blocks %}<article {{ block.shopify_attributes }}>
    <div class="genetix-icon-text__icon">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 180 | image_tag: alt: block.settings.heading }}{% else %}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M8 12h8M12 8v8"/></svg>{% endif %}</div>
    <h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}
  </article>{% endfor %}</div>
</div></section>
{% schema %}{"name":"GENETIX icon text","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE GENETIX PROMISE"},{"type":"text","id":"heading","label":"Heading","default":"Care you can feel good about."},{"type":"richtext","id":"text","label":"Introduction","default":"<p>Considered ingredients. Thoughtful standards. A refined experience.</p>"},{"type":"range","id":"icon_size","label":"Icon size","min":40,"max":100,"step":4,"unit":"px","default":64},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#173c48"}],"blocks":[{"type":"item","name":"Benefit","settings":[{"type":"image_picker","id":"image","label":"Custom icon"},{"type":"text","id":"heading","label":"Heading","default":"Quality first"},{"type":"textarea","id":"text","label":"Description","default":"A considered approach to every detail."},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"GENETIX icon text","blocks":[{"type":"item","settings":{"heading":"Cruelty free"}},{"type":"item","settings":{"heading":"Laboratory tested"}},{"type":"item","settings":{"heading":"Manufactured in an FDA registered facility"}},{"type":"item","settings":{"heading":"Made in the USA"}}]}]}{% endschema %}
