{% comment %}
  Four-column fulfillment promise with individually configured icons and descriptions.
  @example
  Add up to four fulfillment step blocks.
{% endcomment %}
{{ 'genetix-base.css' | asset_url | stylesheet_tag }}
{{ 'genetix-fulfillment.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix__dark genetix-fulfillment custom_gradient_style " style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-fulfillment-muted:{{ section.settings.muted_color }};--gx-fulfillment-line:{{ section.settings.line_color }};--gx-icon:{{ section.settings.icon_size }}px;--gx-pt:{{ section.settings.padding_top }}px;--gx-pb:{{ section.settings.padding_bottom }}px;--gx-pt-mobile:{{ section.settings.padding_top }}px;--gx-pb-mobile:{{ section.settings.padding_bottom }}px;">
  <div class="genetix__inner genetix-fulfillment__inner">
    {% if section.settings.eyebrow != blank %}<p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="genetix-fulfillment__items">
      {% for block in section.blocks %}
        {% unless block.type == '@app' %}
        <article class="genetix-fulfillment__item" {{ block.shopify_attributes }}>
          <div class="genetix-fulfillment__item-heading">
            <div class="genetix-fulfillment__icon">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 120 | image_tag: widths: '40, 80, 120', sizes: '40px', alt: '', loading: 'lazy' }}
              {% else %}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="16" cy="16" r="11"/><path d="M10 16h12M16 10v12"/></svg>
              {% endif %}
            </div>
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          </div>
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
        </article>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
  {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
</section>
{% schema %}
{
  "name": "GENETIX fulfillment",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHIPPING + FULFILLMENT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our facility to your door." },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "color", "id": "background", "label": "Background", "default": "#153640" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "muted_color", "label": "Description text", "default": "#a9bec4" },
    { "type": "color", "id": "line_color", "label": "Item lines", "default": "#49636b" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 52 }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "step", "name": "Fulfillment step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Custom icon" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Prepared with care" },
      { "type": "textarea", "id": "text", "label": "Description", "default": "Add accurate fulfillment details here." }
    ] }
  ],
  "presets": [{ "name": "GENETIX fulfillment", "blocks": [
    { "type": "step", "settings": { "heading": "Free insured U.S. shipping", "text": "Enjoy free standard insured shipping on all domestic U.S. orders." } },
    { "type": "step", "settings": { "heading": "Dispatch in 24–48 hours", "text": "All shipments are securely processed and dispatched from our fulfillment facility within 24 to 48 hours." } },
    { "type": "step", "settings": { "heading": "2–4 business day delivery", "text": "Standard transit delivery takes 2 to 4 business days straight to your door." } },
    { "type": "step", "settings": { "heading": "Automatic tracking emails", "text": "Tracking parameters are automatically emailed to you the moment your package leaves our dock." } }
  ] }]
}
{% endschema %}
