{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-fulfillment.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix__dark genetix-fulfillment" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-icon:{{ section.settings.icon_size }}px"><div class="genetix__inner"><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="genetix-fulfillment__items">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><div class="genetix-fulfillment__icon">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 160 | image_tag: alt: '' }}{% else %}<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="11"/><path d="M10 16h12M16 10v12"/></svg>{% endif %}</div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"GENETIX fulfillment","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SIMPLY DELIVERED"},{"type":"text","id":"heading","label":"Heading","default":"From our facility to your door."},{"type":"range","id":"icon_size","label":"Icon size","min":28,"max":80,"step":4,"unit":"px","default":40},{"type":"color","id":"background","label":"Background","default":"#153640"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"}],"blocks":[{"type":"step","name":"Fulfillment step","settings":[{"type":"image_picker","id":"image","label":"Custom icon"},{"type":"text","id":"heading","label":"Heading","default":"Prepared with care"},{"type":"textarea","id":"text","label":"Description","default":"Add accurate fulfillment details here."}]}],"presets":[{"name":"GENETIX fulfillment","blocks":[{"type":"step"},{"type":"step","settings":{"heading":"Dispatch updates"}},{"type":"step","settings":{"heading":"Delivery tracking"}},{"type":"step","settings":{"heading":"Arrival support"}}]}]}{% endschema %}
