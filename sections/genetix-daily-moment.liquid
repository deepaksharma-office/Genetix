{% comment %}
  Split image and block-managed editorial content for the daily-care story.
  @example
  Add eyebrow text, title, body text, and a button in the desired order.
{% endcomment %}
{{ 'genetix-base.css' | asset_url | stylesheet_tag }}
{{ 'genetix-daily-moment.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix-daily" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};">
  <div class="genetix-daily__layout">
    <picture class="genetix-daily__media">
      {% if section.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}" width="{{ section.settings.mobile_image.width }}" height="{{ section.settings.mobile_image.height }}">{% endif %}
      {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 750px) 51vw, 100vw', loading: 'lazy', alt: section.settings.image_alt }}{% endif %}
    </picture>
    <div class="genetix-daily__content">
      <div class="genetix-daily__blocks">
        {% for block in section.blocks %}
          <div class="genetix-daily__block genetix-daily__block--{{ block.type }}" style="--gx-space-top:{{ block.settings.spacing_top }}px;--gx-space-bottom:{{ block.settings.spacing_bottom }}px;" {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when 'title' %}
                {% if block.settings.title != blank %}<h2 style="--gx-block-color:{{ block.settings.color }};--gx-block-size:{{ block.settings.font_size }}px;--gx-block-size-mobile:{{ block.settings.font_size_mobile }}px;">{{ block.settings.title | escape | newline_to_br }}</h2>{% endif %}
              {% when 'text' %}
                {% if block.settings.text != blank %}<div class="genetix-daily__text{% if block.settings.style == 'eyebrow' %} genetix-daily__text--eyebrow{% endif %} rte" style="--gx-block-color:{{ block.settings.color }};--gx-block-size:{{ block.settings.font_size }}px;">{{ block.settings.text }}</div>{% endif %}
              {% when 'button' %}
                {% if block.settings.label != blank %}{% render 'genetix-button', label: block.settings.label, link: block.settings.link, background: block.settings.background, color: block.settings.color, show_arrow: block.settings.show_arrow, open_new_tab: block.settings.open_new_tab, class: 'genetix-daily__button' %}{% endif %}
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "GENETIX daily moment",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "color", "id": "background", "label": "Background", "default": "#eaf5fa" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#173c48" }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1, "settings": [
      { "type": "textarea", "id": "title", "label": "Title", "default": "Your skin.\nYour scalp.\nYour daily moment." },
      { "type": "color", "id": "color", "label": "Color", "default": "#173c48" },
      { "type": "range", "id": "font_size", "label": "Desktop size", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 50 },
      { "type": "range", "id": "font_size_mobile", "label": "Mobile size", "min": 24, "max": 52, "step": 1, "unit": "px", "default": 36 },
      { "type": "range", "id": "spacing_top", "label": "Spacing top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
      { "type": "range", "id": "spacing_bottom", "label": "Spacing bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bring a little more intention to your routine.</p>" },
      { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "body", "label": "Body" }, { "value": "eyebrow", "label": "Eyebrow" }], "default": "body" },
      { "type": "color", "id": "color", "label": "Color", "default": "#173c48" },
      { "type": "range", "id": "font_size", "label": "Size", "min": 9, "max": 30, "step": 1, "unit": "px", "default": 15 },
      { "type": "range", "id": "spacing_top", "label": "Spacing top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
      { "type": "range", "id": "spacing_bottom", "label": "Spacing bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
    ] },
    { "type": "button", "name": "Button", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Meet the matrix" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": false },
      { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": true },
      { "type": "color", "id": "background", "label": "Background", "default": "#153640" },
      { "type": "color", "id": "color", "label": "Text and icon", "default": "#ffffff" },
      { "type": "range", "id": "spacing_top", "label": "Spacing top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
      { "type": "range", "id": "spacing_bottom", "label": "Spacing bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
    ] }
  ],
  "presets": [{ "name": "GENETIX daily moment", "blocks": [
    { "type": "text", "settings": { "text": "<p>CLINICAL CARE, EVERY DAY</p>", "style": "eyebrow", "font_size": 9, "spacing_bottom": 16 } },
    { "type": "title" },
    { "type": "text", "settings": { "text": "<p>Bring a little more intention to your routine. GENETIX PEPTIDES GHK-Cu Skin & Scalp Matrix brings focused peptide care to your skin and scalp.</p>" } },
    { "type": "button" }
  ] }]
}
{% endschema %}
