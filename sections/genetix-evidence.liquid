{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-evidence.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix-evidence" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }}"><div class="genetix__split"><div class="genetix__panel"><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="genetix__copy">{{ section.settings.text }}</div><ul class="genetix-evidence__list">{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endfor %}</ul></div><article class="genetix-evidence__card"><p class="genetix__eyebrow">{{ section.settings.card_eyebrow | escape }}</p><h3>{{ section.settings.card_heading | escape }}</h3>{% if section.settings.document != blank %}{{ section.settings.document | image_url: width: 700 | image_tag: class: 'genetix__media', alt: section.settings.card_heading }}{% endif %}<div class="genetix__copy">{{ section.settings.card_text }}</div>{% if section.settings.document_link != blank %}<a href="{{ section.settings.document_link }}">{{ section.settings.link_label | escape }}</a>{% endif %}</article></div></section>
{% schema %}{"name":"GENETIX evidence","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BUILT ON EVIDENCE"},{"type":"text","id":"heading","label":"Heading","default":"Evidence matters. Quality comes first."},{"type":"richtext","id":"text","label":"Text","default":"<p>Add only testing and manufacturing claims supported by your records.</p>"},{"type":"text","id":"card_eyebrow","label":"Card eyebrow","default":"DOCUMENTATION"},{"type":"text","id":"card_heading","label":"Card heading","default":"Laboratory testing & lab reports"},{"type":"richtext","id":"card_text","label":"Card text","default":"<p>Make supporting documentation available when appropriate.</p>"},{"type":"image_picker","id":"document","label":"Document preview"},{"type":"url","id":"document_link","label":"Document link"},{"type":"text","id":"link_label","label":"Link label","default":"View report"},{"type":"color","id":"background","label":"Background","default":"#eaf5fa"},{"type":"color","id":"text_color","label":"Text","default":"#173c48"}],"blocks":[{"type":"evidence","name":"Evidence item","settings":[{"type":"text","id":"text","label":"Text","default":"Merchant-supplied evidence item"}]}],"presets":[{"name":"GENETIX evidence","blocks":[{"type":"evidence"},{"type":"evidence"},{"type":"evidence"}]}]}{% endschema %}
