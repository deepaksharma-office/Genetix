{% comment %}
  Editorial split section with philosophy copy on the left and a background-image feature panel on the right.
  @example
  Configure both content columns and select the molecular artwork as the right-panel background.
{% endcomment %}

{{ 'genetix-base.css' | asset_url | stylesheet_tag }}
{{ 'genetix-less-noise.css' | asset_url | stylesheet_tag }}

<section
  class="genetix genetix-less-noise"
  style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-less-muted:{{ section.settings.muted_color }};--gx-less-panel-bg:{{ section.settings.panel_background }};--gx-less-panel-text:{{ section.settings.panel_text_color }};--gx-less-panel-muted:{{ section.settings.panel_muted_color }};--gx-pt:{{ section.settings.padding_top }}px;--gx-pb:{{ section.settings.padding_bottom }}px;--gx-pt-mobile:{{ section.settings.padding_top }}px;--gx-pb-mobile:{{ section.settings.padding_bottom }}px;"
>
  <div class="genetix__inner genetix-less-noise__inner">
    <div class="genetix-less-noise__content">
      {% if section.settings.eyebrow != blank %}
        <p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="genetix-less-noise__copy rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.secondary_text != blank %}
        <div class="genetix-less-noise__secondary rte">{{ section.settings.secondary_text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          class="genetix-less-noise__link"
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          {% if section.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          <span>{{ section.settings.button_label | escape }}</span>
          {% if section.settings.show_arrow %}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" stroke="currentColor" stroke-linecap="square" /></svg>
          {% endif %}
        </a>
      {% endif %}
    </div>

    <div class="genetix-less-noise__panel">
      {% if section.settings.background_image != blank %}
        <picture class="genetix-less-noise__media" aria-hidden="true">
          {% if section.settings.mobile_background_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_background_image | image_url: width: 900 }}"
              width="{{ section.settings.mobile_background_image.width }}"
              height="{{ section.settings.mobile_background_image.height }}"
            >
          {% endif %}
          {{
            section.settings.background_image
            | image_url: width: 1600
            | image_tag: widths: '500, 800, 1100, 1400, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: ''
          }}
        </picture>
      {% endif %}
      <div class="genetix-less-noise__panel-content">
        {% if section.settings.panel_eyebrow != blank %}
          <p class="genetix-less-noise__panel-eyebrow">{{ section.settings.panel_eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.panel_heading != blank %}
          <h3>{{ section.settings.panel_heading | escape | newline_to_br }}</h3>
        {% endif %}
        {% if section.settings.panel_text != blank %}
          <div class="genetix-less-noise__panel-text rte">{{ section.settings.panel_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GENETIX less noise",
  "settings": [
    { "type": "header", "content": "Left content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE GENETIX PHILOSOPHY" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Less noise.\nMore intention." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We believe great care begins with a considered formula. The GENETIX MATRIX brings together five active ingredients in one skin and scalp routine.</p>" },
    { "type": "richtext", "id": "secondary_text", "label": "Secondary text", "default": "<p>Precision in formulation. Purpose in every ingredient.</p>" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Meet the ingredient matrix" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": false },
    { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": true },
    { "type": "header", "content": "Right content" },
    { "type": "text", "id": "panel_eyebrow", "label": "Eyebrow", "default": "THE MATRIX" },
    { "type": "textarea", "id": "panel_heading", "label": "Heading", "default": "The beauty\nof precision." },
    { "type": "richtext", "id": "panel_text", "label": "Text", "default": "<p>Biotechnology. Refined.</p>" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_background_image", "label": "Mobile background image" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Left text", "default": "#173c48" },
    { "type": "color", "id": "muted_color", "label": "Left muted text", "default": "#647c84" },
    { "type": "color", "id": "panel_background", "label": "Panel background", "default": "#eaf5fa" },
    { "type": "color", "id": "panel_text_color", "label": "Panel heading", "default": "#173c48" },
    { "type": "color", "id": "panel_muted_color", "label": "Panel muted text", "default": "#647c84" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 52 }
  ],
  "presets": [{ "name": "GENETIX less noise" }]
}
{% endschema %}
