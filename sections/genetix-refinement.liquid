{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-refinement.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix-refinement" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }}"><div class="genetix__inner"><div class="genetix__split"><picture class="genetix-refinement__media">{% if section.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">{% endif %}{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400,700,900,1200', alt: section.settings.image_alt }}{% endif %}</picture><div class="genetix__panel"><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="genetix__copy">{{ section.settings.text }}</div><div class="genetix-refinement__specs">{% for block in section.blocks %}<div class="genetix-refinement__spec" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><strong>{{ block.settings.value | escape }}</strong></div>{% endfor %}</div>{% if section.settings.button_link != blank %}<a class="genetix__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></div></div></section>
{% schema %}{"name":"GENETIX refinement","max_blocks":8,"settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"image_alt","label":"Image alt text"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BUILT FOR A CONSIDERED ROUTINE"},{"type":"text","id":"heading","label":"Heading","default":"Refinement, in your hands."},{"type":"richtext","id":"text","label":"Text","default":"<p>A refined format designed to fit into your routine.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Discover more"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#173c48"}],"blocks":[{"type":"spec","name":"Specification","settings":[{"type":"text","id":"label","label":"Label","default":"Format"},{"type":"text","id":"value","label":"Value","default":"Merchant supplied"}]}],"presets":[{"name":"GENETIX refinement","blocks":[{"type":"spec"},{"type":"spec","settings":{"label":"Size"}},{"type":"spec","settings":{"label":"Routine"}}]}]}{% endschema %}
