{{ 'genetix-footer.css' | asset_url | stylesheet_tag }}
<section class="genetix-footer" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-line:{{ section.settings.border_color }}"><div class="genetix-footer__inner"><div class="genetix-footer__grid"><div>{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 400 | image_tag: class: 'genetix-footer__logo', widths: '140,220,320,400', alt: shop.name }}{% else %}<strong>{{ shop.name | escape }}</strong>{% endif %}{% if section.settings.description != blank %}<div>{{ section.settings.description }}</div>{% endif %}<div class="genetix-footer__social">{% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" aria-label="Instagram">Instagram</a>{% endif %}{% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" aria-label="Facebook">Facebook</a>{% endif %}</div></div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2>{% if block.settings.menu != blank %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}</div><div class="genetix-footer__bottom"><span>{{ section.settings.copyright | default: shop.name | escape }}</span>{% if section.settings.contact != blank %}<span>{{ section.settings.contact | escape }}</span>{% endif %}{% if section.settings.show_payments %}<div class="genetix-footer__payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}</div></div></section>
{% schema %}{"name":"GENETIX footer","max_blocks":4,"enabled_on":{"groups":["footer"]},"settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"richtext","id":"description","label":"Brand description","default":"<p>Clinical peptide science, thoughtfully composed.</p>"},{"type":"text","id":"contact","label":"Contact information"},{"type":"url","id":"instagram","label":"Instagram URL"},{"type":"url","id":"facebook","label":"Facebook URL"},{"type":"text","id":"copyright","label":"Copyright text","default":"GENETIX Peptides"},{"type":"checkbox","id":"show_payments","label":"Show payment icons","default":true},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#173c48"},{"type":"color","id":"border_color","label":"Borders","default":"#dce7eb"}],"blocks":[{"type":"links","name":"Link column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu"}]}],"presets":[{"name":"GENETIX footer","blocks":[{"type":"links"},{"type":"links","settings":{"heading":"Customer care"}},{"type":"links","settings":{"heading":"Company"}}]}]}{% endschema %}
