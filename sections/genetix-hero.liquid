{% comment %}
  GENETIX landing hero with block-managed copy and layered product artwork.
  @example
  Add title, text, and button blocks from the theme editor.
{% endcomment %}
{{ 'genetix-base.css' | asset_url | stylesheet_tag }}
{{ 'genetix-hero.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix-hero" style="--gx-bg:{{ section.settings.background }};--gx-overlay:{{ section.settings.overlay }};--gx-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--gx-min-height:{{ section.settings.min_height }}px;--gx-min-height-mobile:{{ section.settings.mobile_min_height }}px;--gx-product-width:{{ section.settings.product_width }}px;--gx-product-position-x:{{ section.settings.product_position_x }}%;--gx-product-position-y:{{ section.settings.product_position_y }}%;--gx-float-color:{{ section.settings.floating_text_color }};--gx-float-size:{{ section.settings.floating_text_size }}px;--gx-float-position-x:{{ section.settings.floating_text_position_x }}%;--gx-float-offset-y:{{ section.settings.floating_text_offset_y }}%;">
  {% if section.settings.image != blank %}
    <picture class="genetix-hero__background">
      {% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}" width="{{ section.settings.mobile_image.width }}" height="{{ section.settings.mobile_image.height }}">{% endif %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
    </picture>
  {% endif %}
  <span class="genetix-hero__overlay" aria-hidden="true"></span>
  <div class="genetix__inner genetix-hero__inner">
    <div class="genetix-hero__content" style="text-align:{{ section.settings.alignment }};">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            {% if block.settings.title != blank %}<div class="genetix-hero__block genetix-hero__title-block" style="--gx-block-color:{{ block.settings.color }};--gx-block-size:{{ block.settings.font_size }}px;--gx-block-size-mobile:{{ block.settings.font_size_mobile }}px;--gx-highlight-color:{{ block.settings.highlight_color }};" {{ block.shopify_attributes }}><h1>{{ block.settings.title }}</h1></div>{% endif %}
          {% when 'text' %}
            {% if block.settings.text != blank %}<div class="genetix-hero__block genetix-hero__text-block{% if block.settings.style == 'eyebrow' %} genetix-hero__text-block--eyebrow{% endif %}" style="--gx-block-color:{{ block.settings.color }};--gx-block-size:{{ block.settings.font_size }}px;--gx-block-size-mobile:{{ block.settings.font_size_mobile }}px;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% endif %}
          {% when 'button' %}
            {% if block.settings.label != blank %}<div class="genetix-hero__block genetix-hero__button-block" {{ block.shopify_attributes }}>{% render 'genetix-button', label: block.settings.label, link: block.settings.link, background: block.settings.background, color: block.settings.color, show_arrow: block.settings.show_arrow, open_new_tab: block.settings.open_new_tab, class: 'genetix-hero__button' %}</div>{% endif %}
        {% endcase %}
      {% endfor %}
    </div>
    {% if section.settings.product_image != blank %}
      <div class="genetix-hero__product-stage">
        {% if section.settings.floating_text != blank %}<span class="genetix-hero__floating-text" aria-hidden="true">{{ section.settings.floating_text | escape }}</span>{% endif %}
        {{ section.settings.product_image | image_url: width: 900 | image_tag: class: 'genetix-hero__product', widths: '240, 360, 500, 700, 900', sizes: '(min-width: 750px) 35vw, 58vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.product_alt }}
      </div>
    {% endif %}
  </div>
  {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
</section>
{% schema %}
{
  "name": "GENETIX hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop background" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background" },
    { "type": "text", "id": "image_alt", "label": "Background image alt text" },
    { "type": "image_picker", "id": "product_image", "label": "Floating product image" },
    { "type": "text", "id": "product_alt", "label": "Product image alt text" },
    { "type": "range", "id": "product_width", "label": "Product width", "min": 180, "max": 600, "step": 10, "unit": "px", "default": 340 },
    { "type": "range", "id": "product_position_x", "label": "Product horizontal position", "min": 45, "max": 95, "step": 1, "unit": "%", "default": 72 },
    { "type": "range", "id": "product_position_y", "label": "Product vertical position", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 8 },
    { "type": "header", "content": "Floating text" },
    { "type": "text", "id": "floating_text", "label": "Text", "default": "GHK-Cu" },
    { "type": "color", "id": "floating_text_color", "label": "Color", "default": "#9ddfeb" },
    { "type": "range", "id": "floating_text_size", "label": "Size", "min": 40, "max": 240, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "floating_text_position_x", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "floating_text_offset_y", "label": "Offset below product top", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 20 },
    { "type": "text_alignment", "id": "alignment", "label": "Content alignment", "default": "left" },
    { "type": "color", "id": "background", "label": "Background", "default": "#eef8fb" },
    { "type": "color", "id": "overlay", "label": "Overlay", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 5 },
    { "type": "range", "id": "min_height", "label": "Desktop minimum height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile minimum height", "min": 420, "max": 900, "step": 20, "unit": "px", "default": 680 }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1, "settings": [
      { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Clinical peptide science. <strong>Uncompromised quality.</strong> Superior bioavailability." },
      { "type": "color", "id": "color", "label": "Text color", "default": "#173c48" },
      { "type": "color", "id": "highlight_color", "label": "Bold highlight color", "default": "#2196b5" },
      { "type": "range", "id": "font_size", "label": "Desktop size", "min": 24, "max": 92, "step": 1, "unit": "px", "default": 48 },
      { "type": "range", "id": "font_size_mobile", "label": "Mobile size", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 36 }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Targeted support for healthier-looking hair and scalp.</p>" },
      { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "body", "label": "Body" }, { "value": "eyebrow", "label": "Eyebrow" }], "default": "body" },
      { "type": "color", "id": "color", "label": "Text color", "default": "#173c48" },
      { "type": "range", "id": "font_size", "label": "Desktop size", "min": 10, "max": 36, "step": 1, "unit": "px", "default": 16 },
      { "type": "range", "id": "font_size_mobile", "label": "Mobile size", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 15 }
    ] },
    { "type": "button", "name": "Shop button", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": false },
      { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": true },
      { "type": "color", "id": "background", "label": "Background", "default": "#153640" },
      { "type": "color", "id": "color", "label": "Text and icon", "default": "#ffffff" }
    ] }
  ],
  "presets": [{ "name": "GENETIX hero", "blocks": [
    { "type": "text", "settings": { "text": "<p>THE SCIENCE OF CONSIDERED CARE</p>", "style": "eyebrow", "font_size": 11, "font_size_mobile": 10 } },
    { "type": "title" },
    { "type": "text", "settings": { "text": "<p>GHK-Cu Skin & Scalp Matrix</p>", "font_size": 17, "font_size_mobile": 15 } },
    { "type": "text", "settings": { "text": "<p>Most skincare brands sell watered-down formulas that sit on the surface. GENETIX PEPTIDES engineers advanced, lipid-stabilized matrices designed to penetrate the oil barrier and remodel the skin from the deep dermis up.</p>", "font_size": 14, "font_size_mobile": 14 } },
    { "type": "button" }
  ] }]
}
{% endschema %}
