{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-second-coming.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix-second" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }}"><div class="genetix__inner"><div class="genetix__split"><div class="genetix__panel"><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="genetix__copy">{{ section.settings.text }}</div>{% if section.settings.button_link != blank %}<a class="genetix__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div><picture class="genetix-second__media">{% if section.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">{% endif %}{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400,700,900,1200', alt: section.settings.image_alt }}{% endif %}</picture></div></div></section>
{% schema %}{"name":"GENETIX second coming","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMING SOON"},{"type":"text","id":"heading","label":"Heading","default":"Second Coming"},{"type":"richtext","id":"text","label":"Text","default":"<p>A new addition to the GENETIX collection.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Learn more"},{"type":"url","id":"button_link","label":"Button or product link"},{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"image_alt","label":"Image alt text"},{"type":"color","id":"background","label":"Background","default":"#eaf5fa"},{"type":"color","id":"text_color","label":"Text","default":"#173c48"}],"presets":[{"name":"GENETIX second coming"}]}{% endschema %}
