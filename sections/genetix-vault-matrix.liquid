{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-vault-matrix.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix__dark genetix-vault" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }}"><div class="genetix__inner"><div class="genetix-vault__top"><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2>{{ section.settings.text }}</div><div class="genetix-vault__metrics"><div>{% for block in section.blocks limit: 2 %}<div class="genetix-vault__metric" {{ block.shopify_attributes }}><strong>{{ block.settings.value | escape }}</strong><span>{{ block.settings.label | escape }}</span></div>{% endfor %}</div><div class="genetix-vault__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 700 | image_tag: class: 'genetix-vault__image', alt: section.settings.image_alt }}{% endif %}</div><div>{% for block in section.blocks offset: 2 %}<div class="genetix-vault__metric" {{ block.shopify_attributes }}><strong>{{ block.settings.value | escape }}</strong><span>{{ block.settings.label | escape }}</span></div>{% endfor %}</div></div>{% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="genetix__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></section>
{% schema %}{"name":"GENETIX vault matrix","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE VAULT MATRIX"},{"type":"text","id":"heading","label":"Heading","default":"Unmatched quality. Uncompromised value."},{"type":"richtext","id":"text","label":"Text","default":"<p>Carefully considered. Precisely composed.</p>"},{"type":"image_picker","id":"image","label":"Product image"},{"type":"text","id":"image_alt","label":"Image alt text"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the matrix"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color","id":"background","label":"Background","default":"#153640"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"}],"blocks":[{"type":"metric","name":"Metric","settings":[{"type":"text","id":"value","label":"Value","default":"2 oz"},{"type":"text","id":"label","label":"Label","default":"Net contents"}]}],"presets":[{"name":"GENETIX vault matrix","blocks":[{"type":"metric","settings":{"value":"$150–$199","label":"Comparable value"}},{"type":"metric","settings":{"value":"1 oz","label":"Standard size"}},{"type":"metric"},{"type":"metric","settings":{"value":"2×","label":"The volume"}}]}]}{% endschema %}
