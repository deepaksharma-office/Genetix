{% comment %}
  Block-driven featured product with a static gallery and reorderable product content.
  @example
  Select a product and arrange its content blocks in the theme editor.
{% endcomment %}

{{ 'genetix-base.css' | asset_url | stylesheet_tag }}
{{ 'genetix-featured-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'genetix-featured-product.js' | asset_url }}" type="module"></script>

{% liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'GenetixProductForm-' | append: section.id
%}

<section
  class="genetix genetix-product"
  style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-media-bg:{{ section.settings.media_background }};--gx-pt:{{ section.settings.padding_top }}px;--gx-pb:{{ section.settings.padding_bottom }}px;--gx-pt-mobile:{{ section.settings.padding_top_mobile }}px;--gx-pb-mobile:{{ section.settings.padding_bottom_mobile }}px;"
>
  <div class="genetix__inner genetix-product__inner genetix-product__inner--{{ section.settings.section_width }}">
    <genetix-product
      id="GenetixProduct-{{ section.id }}"
      data-section-id="{{ section.id }}"
      data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
      data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
      data-unavailable-label="{{ 'products.product.unavailable' | t | escape }}"
    >
      {% form 'product', product, id: form_id, class: 'genetix-product__form' %}
        <input type="hidden" name="id" value="{{ variant.id }}" data-form-variant>
      {% endform %}
      <div class="genetix-product__layout genetix-product__layout--{{ section.settings.gallery_position }}{% if section.settings.sticky_gallery %} genetix-product__layout--sticky{% endif %}">
        {% content_for 'block', type: '_genetix-product-gallery', id: 'gallery', closest.product: product %}
        <div class="genetix-product__details">
          {% if product != blank %}
            {% content_for 'blocks', closest.product: product %}
          {% else %}
            <p class="genetix__copy">{{ 'placeholders.product_title' | t }}</p>
          {% endif %}
          <p class="genetix-product__error" data-error role="status" aria-live="polite"></p>
        </div>
      </div>
    </genetix-product>
  </div>
</section>

{% schema %}
{
  "name": "GENETIX featured product",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "select", "id": "gallery_position", "label": "Gallery position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "checkbox", "id": "sticky_gallery", "label": "Sticky gallery on desktop", "default": true },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "wide", "label": "Wide" }], "default": "page" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "media_background", "label": "Media background", "default": "#eef8fb" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#173c48" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile padding top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile padding bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 }
  ],
  "presets": [
    {
      "name": "GENETIX featured product",
      "blocks": {
        "gallery": { "type": "_genetix-product-gallery", "static": true, "settings": { "label": "GHK-Cu SCALP MATRIX", "show_thumbnails": true } },
        "eyebrow": { "type": "genetix-product-eyebrow", "settings": { "text": "THE DAILY ESSENTIAL" } },
        "title": { "type": "genetix-product-title", "settings": {} },
        "meta": { "type": "genetix-product-text", "settings": { "text": "<p>2 fl oz / 60 ml · Skin + Scalp</p>", "style": "meta" } },
        "price": { "type": "genetix-product-price", "settings": { "currency_label": "USD" } },
        "description": { "type": "genetix-product-description", "settings": {} },
        "impact-ghk": { "type": "genetix-product-impact", "settings": { "value": "2%", "label": "GHK-Cu" } },
        "impact-pal": { "type": "genetix-product-impact", "settings": { "value": "6%", "label": "PAL-150" } },
        "impact-niacinamide": { "type": "genetix-product-impact", "settings": { "value": "3%", "label": "Niacinamide" } },
        "impact-pdrn": { "type": "genetix-product-impact", "settings": { "value": "0.25%", "label": "PDRN+" } },
        "variant": { "type": "genetix-product-variant-selector", "settings": { "label": "Choose an option" } },
        "quantity": { "type": "genetix-product-quantity", "settings": {} },
        "add": { "type": "genetix-product-add-button", "settings": { "label": "Add to bag", "show_price": true, "show_arrow": true, "background": "#153640", "color": "#ffffff" } },
        "buy": { "type": "genetix-product-buy-button", "settings": { "label": "Buy", "show_arrow": true } },
        "secure": { "type": "genetix-product-icon-text", "settings": { "icon": "shield", "text": "Secure checkout" } },
        "shipping-note": { "type": "genetix-product-icon-text", "settings": { "icon": "truck", "text": "Free insured U.S. shipping" } },
        "details": { "type": "genetix-product-accordion", "settings": { "heading": "Formula & ingredients", "content": "<p>Add product details here.</p>" } },
        "quality": { "type": "genetix-product-accordion", "settings": { "heading": "Quality & laboratory testing", "content": "<p>Add product details here.</p>" } },
        "shipping": { "type": "genetix-product-accordion", "settings": { "heading": "Shipping & fulfillment", "content": "<p>Add product details here.</p>" } }
      },
      "block_order": ["eyebrow", "title", "meta", "price", "description", "impact-ghk", "impact-pal", "impact-niacinamide", "impact-pdrn", "variant", "quantity", "add", "buy", "secure", "shipping-note", "details", "quality", "shipping"]
    }
  ]
}
{% endschema %}
