{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-featured-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'genetix-featured-product.js' | asset_url }}" type="module"></script>
{% assign product = section.settings.product %}{% assign variant = product.selected_or_first_available_variant %}
<section class="genetix genetix-product" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }}"><div class="genetix__inner">
<genetix-product id="GenetixProduct-{{ section.id }}"><div class="genetix-product__layout"><div>
  <button class="genetix-product__main" type="button" data-zoom-open aria-label="Zoom product image">{% if product.featured_media != blank %}{{ product.featured_media.preview_image | image_url: width: 1100 | image_tag: class: 'genetix__media', widths: '400,700,900,1100', alt: product.featured_media.alt, data-main-image: '' }}{% else %}<span>Select a product to display its media.</span>{% endif %}</button>
  <div class="genetix-product__thumbs">{% for media in product.media limit: 6 %}<button class="genetix-product__thumb" type="button" data-media-src="{{ media.preview_image | image_url: width: 1600 }}" data-media-alt="{{ media.alt | escape }}" aria-label="View {{ media.alt | default: product.title | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 140 | image_tag: alt: '' }}</button>{% endfor %}</div>
  {% if product.featured_media != blank %}<dialog class="genetix-product__zoom"><button class="genetix-product__zoom-close" type="button" data-zoom-close aria-label="Close image zoom">×</button>{{ product.featured_media.preview_image | image_url: width: 1800 | image_tag: alt: product.featured_media.alt, data-zoom-image: '' }}</dialog>{% endif %}
</div><div><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ product.title | default: section.settings.fallback_title | escape }}</h2>
  {% if product != blank %}<p><span class="genetix-product__price" data-price>{{ variant.price | money }}</span>{% if variant.compare_at_price > variant.price %}<span class="genetix-product__compare">{{ variant.compare_at_price | money }}</span>{% endif %}</p><div class="genetix__copy">{{ product.description | strip_html | truncatewords: 45 }}</div>
  {% form 'product', product %}<label for="Variant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for item in product.variants %}<option value="{{ item.id }}" data-price="{{ item.price | money }}" data-available="{{ item.available }}" {% if item == variant %}selected{% endif %}>{{ item.title | escape }}</option>{% endfor %}</select><input type="hidden" name="quantity" value="1"><button class="genetix__button genetix-product__submit" type="submit" {% unless variant.available %}disabled{% endunless %}>{{ section.settings.button_label | escape }}</button><p class="genetix-product__error" data-error role="status"></p>{% endform %}
  {% else %}<p class="genetix__copy">Choose a product in the theme editor.</p>{% endif %}
  {% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary>{{ block.settings.content }}</details>{% endfor %}
</div></div></genetix-product></div></section>
{% schema %}{"name":"GENETIX featured product","max_blocks":4,"settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE HERO FORMULA"},{"type":"text","id":"fallback_title","label":"Placeholder title","default":"GENETIX PEPTIDES GHK-Cu Skin & Scalp Matrix"},{"type":"text","id":"variant_label","label":"Variant label","default":"Choose an option"},{"type":"text","id":"button_label","label":"Purchase button label","default":"Add to cart"},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#173c48"}],"blocks":[{"type":"accordion","name":"Information row","settings":[{"type":"text","id":"heading","label":"Heading","default":"Product & ingredients"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add product details here.</p>"}]}],"presets":[{"name":"GENETIX featured product","blocks":[{"type":"accordion"},{"type":"accordion","settings":{"heading":"Quality & laboratory testing"}},{"type":"accordion","settings":{"heading":"Shipping & fulfillment"}}]}]}{% endschema %}
