{{ 'image-text-offer.css' | asset_url | stylesheet_tag }}

{% liquid
  assign section_id = 'ImageTextOffer-' | append: section.id
  assign background_type = section.settings.background_type
%}

<section
  id="{{ section_id }}"
  class="
    image-text-offer
    image-text-offer--image-{{ section.settings.image_position }}
    image-text-offer--align-{{ section.settings.vertical_alignment }}
    image-text-offer--mobile-{{ section.settings.mobile_layout }}
    image-text-offer--bg-{{ background_type }}
  "
  style="
    --ito-max-width: {{ section.settings.max_width }}px;

    --ito-padding-top: {{ section.settings.padding_top }}px;
    --ito-padding-bottom: {{ section.settings.padding_bottom }}px;

    --ito-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ito-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --ito-side-padding: {{ section.settings.side_padding }}px;
    --ito-side-padding-mobile: {{ section.settings.side_padding_mobile }}px;

    --ito-column-gap: {{ section.settings.column_gap }}px;
    --ito-mobile-gap: {{ section.settings.mobile_gap }}px;

    --ito-content-width: {{ section.settings.content_width }}%;
    --ito-image-width: {{ section.settings.image_width }}%;

    --ito-background-color: {{ section.settings.background_color }};
    --ito-background-gradient: {{ section.settings.background_gradient }};

    --ito-bg-overlay: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};

    --ito-divider-color: {{ section.settings.divider_color }};
    --ito-divider-opacity: {{ section.settings.divider_opacity | divided_by: 100.0 }};
    --ito-divider-margin-top: {{ section.settings.divider_margin_top }}px;
    --ito-divider-margin-bottom: {{ section.settings.divider_margin_bottom }}px;

    --ito-footer-color: {{ section.settings.footer_text_color }};
    --ito-footer-size: {{ section.settings.footer_text_size }}px;

    --ito-main-image-max-width: {{ section.settings.main_image_max_width }}px;

    --ito-float-width: {{ section.settings.floating_image_width }}px;
    --ito-float-width-mobile: {{ section.settings.floating_image_width_mobile }}px;
    --ito-float-x: {{ section.settings.floating_image_x }}px;
    --ito-float-y: {{ section.settings.floating_image_y }}px;
    --ito-float-opacity: {{ section.settings.floating_image_opacity | divided_by: 100.0 }};
    --ito-float-z: {{ section.settings.floating_image_z_index }};
  "
>
  {% if background_type == 'image' and section.settings.background_image != blank %}
    <div
      class="image-text-offer__background"
      style="
        background-image: url('{{ section.settings.background_image | image_url: width: 3000 }}');
        background-position: {{ section.settings.background_position }};
      "
      aria-hidden="true"
    ></div>

    {% if section.settings.background_overlay_opacity > 0 %}
      <div
        class="image-text-offer__background-overlay"
        style="background: {{ section.settings.background_overlay_color }};"
        aria-hidden="true"
      ></div>
    {% endif %}
  {% endif %}

  {% if section.settings.floating_image != blank %}
    <div
      class="
        image-text-offer__floating-image
        image-text-offer__floating-image--{{ section.settings.floating_image_position }}
        {% unless section.settings.show_floating_image_mobile %}
          image-text-offer__floating-image--hide-mobile
        {% endunless %}
      "
      aria-hidden="true"
    >
      {{
        section.settings.floating_image
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          widths: '150, 250, 350, 500, 700, 900, 1200',
          sizes: '(max-width: 749px) 250px, 500px',
          class: 'image-text-offer__floating-img'
      }}
    </div>
  {% endif %}

  <div class="image-text-offer__inner">

    <div class="image-text-offer__main">

      <div class="image-text-offer__content">
        <div class="image-text-offer__blocks">

          {% for block in section.blocks %}
            {% case block.type %}

              {% when 'title' %}
                {% liquid
                  assign title_tag = block.settings.tag
                %}

                <div
                  class="image-text-offer__block image-text-offer__title-block"
                  style="
                    --block-color: {{ block.settings.color }};
                    --block-bold-color: {{ block.settings.bold_color }};
                    --block-size: {{ block.settings.font_size }}px;
                    --block-size-mobile: {{ block.settings.font_size_mobile }}px;
                    --block-weight: {{ block.settings.font_weight }};
                    --block-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
                    --block-spacing-bottom: {{ block.settings.spacing_bottom }}px;
                    --block-letter-spacing: {{ block.settings.letter_spacing | divided_by: 10.0 }}px;
                  "
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.title != blank %}
                    <{{ title_tag }} class="image-text-offer__title">
                      {{ block.settings.title }}
                    </{{ title_tag }}>
                  {% endif %}
                </div>


              {% when 'text' %}
                <div
                  class="image-text-offer__block image-text-offer__text-block"
                  style="
                    --block-color: {{ block.settings.color }};
                    --block-bold-color: {{ block.settings.bold_color }};
                    --block-size: {{ block.settings.font_size }}px;
                    --block-size-mobile: {{ block.settings.font_size_mobile }}px;
                    --block-line-height: {{ block.settings.line_height | divided_by: 100.0 }};
                    --block-spacing-bottom: {{ block.settings.spacing_bottom }}px;
                  "
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.text != blank %}
                    <div class="image-text-offer__text rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>


              {% when 'button' %}
                <div
                  class="
                    image-text-offer__block
                    image-text-offer__button-block
                    image-text-offer__button-block--{{ block.settings.alignment }}
                  "
                  style="
                    --button-background: {{ block.settings.background_color }};
                    --button-text: {{ block.settings.text_color }};
                    --button-icon: {{ block.settings.icon_color }};
                    --button-border: {{ block.settings.border_color }};
                    --button-border-width: {{ block.settings.border_width }}px;
                    --button-radius: {{ block.settings.border_radius }}px;

                    --button-font-size: {{ block.settings.font_size }}px;
                    --button-font-size-mobile: {{ block.settings.font_size_mobile }}px;

                    --button-padding-x: {{ block.settings.padding_horizontal }}px;
                    --button-padding-y: {{ block.settings.padding_vertical }}px;

                    --button-icon-size: {{ block.settings.icon_size }}px;
                    --button-gap: {{ block.settings.icon_gap }}px;

                    --block-spacing-bottom: {{ block.settings.spacing_bottom }}px;
                  "
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.label != blank %}
                    <a
                      {% if block.settings.link != blank %}
                        href="{{ block.settings.link }}"
                      {% else %}
                        role="link"
                        aria-disabled="true"
                      {% endif %}
                      class="image-text-offer__button"
                      {% if block.settings.open_new_tab and block.settings.link != blank %}
                        target="_blank"
                        rel="noopener noreferrer"
                      {% endif %}
                    >
                      <span>{{ block.settings.label }}</span>

                      {% if block.settings.show_icon %}
                        <span class="image-text-offer__button-icon">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <path d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"></path>
                          </svg>
                        </span>
                      {% endif %}
                    </a>
                  {% endif %}
                </div>

            {% endcase %}
          {% endfor %}

        </div>
      </div>

      <div class="image-text-offer__media">
        {% if section.settings.image != blank %}
          <div
            class="
              image-text-offer__image-wrapper
              image-text-offer__image-wrapper--{{ section.settings.image_fit }}
            "
          >
            {{
              section.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400',
                sizes: '(max-width: 749px) 100vw, 50vw',
                class: 'image-text-offer__image'
            }}
          </div>
        {% else %}
          <div class="image-text-offer__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

    </div>

    {% if section.settings.show_footer %}
      <div class="image-text-offer__footer">

        {% if section.settings.show_divider %}
          <div class="image-text-offer__divider"></div>
        {% endif %}

        <div
          class="
            image-text-offer__footer-content
            image-text-offer__footer-content--{{ section.settings.footer_alignment_mobile }}
          "
        >
          {% if section.settings.disclaimer != blank %}
            <div class="image-text-offer__disclaimer rte">
              {{ section.settings.disclaimer }}
            </div>
          {% endif %}

          {% if section.settings.footer_right_text != blank %}
            <div class="image-text-offer__footer-right">
              {{ section.settings.footer_right_text }}
            </div>
          {% endif %}
        </div>

      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Image text offer",
  "tag": "section",
  "class": "shopify-section-image-text-offer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width",
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Content vertical alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "content-first",
          "label": "Content first"
        },
        {
          "value": "image-first",
          "label": "Image first"
        }
      ],
      "default": "content-first"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Desktop column gap",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile content/image gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },

    {
      "type": "header",
      "content": "Main image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "main_image_max_width",
      "label": "Image maximum width",
      "min": 200,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 700
    },

    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Background image"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Solid background color",
      "default": "#041B3A"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradient background",
      "default": "linear-gradient(135deg, #02152f 0%, #062b60 50%, #02152f 100%)"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background image position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        },
        {
          "value": "left top",
          "label": "Top left"
        },
        {
          "value": "right top",
          "label": "Top right"
        },
        {
          "value": "left bottom",
          "label": "Bottom left"
        },
        {
          "value": "right bottom",
          "label": "Bottom right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "background_overlay_color",
      "label": "Background image overlay",
      "default": "#00142E"
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "label": "Background image overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },

    {
      "type": "header",
      "content": "Floating image"
    },
    {
      "type": "image_picker",
      "id": "floating_image",
      "label": "Floating image"
    },
    {
      "type": "select",
      "id": "floating_image_position",
      "label": "Floating image position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "center-left",
          "label": "Center left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "center-right",
          "label": "Center right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "center-right"
    },
    {
      "type": "range",
      "id": "floating_image_width",
      "label": "Desktop floating image width",
      "min": 40,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "floating_image_width_mobile",
      "label": "Mobile floating image width",
      "min": 40,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "floating_image_x",
      "label": "Horizontal offset",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "floating_image_y",
      "label": "Vertical offset",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "floating_image_opacity",
      "label": "Floating image opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "floating_image_z_index",
      "label": "Floating image layer",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_floating_image_mobile",
      "label": "Show floating image on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Bottom content"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show bottom content",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "divider_opacity",
      "label": "Divider opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 35
    },
    {
      "type": "range",
      "id": "divider_margin_top",
      "label": "Space above divider",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "divider_margin_bottom",
      "label": "Space below divider",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Left disclaimer",
      "default": "<p>Sign by November 30, 2026 to claim. New projects only.<br>Excludes existing projects and maintenance fees.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "footer_right_text",
      "label": "Right bottom text",
      "default": "www.rootsyntax.com"
    },
    {
      "type": "color",
      "id": "footer_text_color",
      "label": "Bottom text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "footer_text_size",
      "label": "Bottom text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "footer_alignment_mobile",
      "label": "Mobile bottom alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Desktop side padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Mobile side padding",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Better Shopify <strong>experiences.</strong>"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            },
            {
              "value": "div",
              "label": "Div"
            },
            {
              "value": "p",
              "label": "Paragraph"
            }
          ],
          "default": "h2"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "bold_color",
          "label": "Bold text color",
          "default": "#FF7200"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Desktop font size",
          "min": 16,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 58
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Mobile font size",
          "min": 16,
          "max": 70,
          "step": 1,
          "unit": "px",
          "default": 42
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "options": [
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semi bold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra bold"
            },
            {
              "value": "900",
              "label": "Black"
            }
          ],
          "default": "700"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 80,
          "max": 180,
