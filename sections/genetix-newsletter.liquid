{% comment %}
  VIP newsletter signup with merchant-managed copy and Shopify customer marketing consent.
  @example
  Add the section near the end of the home page and configure its access message.
{% endcomment %}

{{ 'genetix-base.css' | asset_url | stylesheet_tag }}
{{ 'genetix-newsletter.css' | asset_url | stylesheet_tag }}

<section
  class="genetix genetix-newsletter"
  style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-button-bg:{{ section.settings.button_background }};--gx-button-color:{{ section.settings.button_color }};--gx-pt:{{ section.settings.padding_top }}px;--gx-pb:{{ section.settings.padding_bottom }}px;--gx-pt-mobile:{{ section.settings.padding_top }}px;--gx-pb-mobile:{{ section.settings.padding_bottom }}px;"
>
  <div class="genetix-newsletter__orbit" aria-hidden="true"></div>
  <div class="genetix__inner genetix-newsletter__inner">
    <div class="genetix-newsletter__content">
      {% if section.settings.eyebrow != blank %}
        <p class="genetix__eyebrow genetix-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="genetix-newsletter__intro">
        <svg class="genetix-newsletter__mark" viewBox="0 0 24 36" fill="none" stroke="currentColor" aria-hidden="true">
          <path d="M4 1c12 7 12 27 0 34M20 1C8 8 8 28 20 35M6.5 7h11M4.5 14h15M4.5 22h15M6.5 29h11"/>
        </svg>
        <div class="genetix__copy">{{ section.settings.text }}</div>
      </div>
    </div>

    {% form 'customer', class: 'genetix-newsletter__customer-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="Newsletter-{{ section.id }}">{{ 'blocks.email_signup.label' | t }}</label>
      <div class="genetix-newsletter__form">
        <input
          id="Newsletter-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder | escape }}"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterMessage-{{ section.id }}"{% endif %}
        >
        <button type="submit">{{ section.settings.button_label | escape }}</button>
      </div>
      {% if section.settings.fine_print != blank %}
        <div class="genetix-newsletter__fine-print">{{ section.settings.fine_print }}</div>
      {% endif %}
      {% if form.posted_successfully? %}
        <p id="NewsletterMessage-{{ section.id }}" class="genetix-newsletter__message" role="status">{{ 'blocks.email_signup.success' | t }}</p>
      {% elsif form.errors %}
        <div id="NewsletterMessage-{{ section.id }}" class="genetix-newsletter__message" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "GENETIX newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRIVATE ACCESS / GENETIX PEPTIDES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "GENETIX PEPTIDES: Clinical Cellular Matrix." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join our VIP Mailing List for new product updates, official launch dates, exclusive access to upcoming giveaways, and priority allocation on our high-purity GHK-Cu topical production runs.</p>" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the VIP list" },
    { "type": "richtext", "id": "fine_print", "label": "Fine print", "default": "<p>By subscribing, you agree to receive GENETIX email updates. You can unsubscribe at any time.</p>" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#173c48" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#153640" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "GENETIX newsletter" }]
}
{% endschema %}
