{{ 'genetix-base.css' | asset_url | stylesheet_tag }}{{ 'genetix-newsletter.css' | asset_url | stylesheet_tag }}
<section class="genetix genetix-newsletter" style="--gx-bg:{{ section.settings.background }};--gx-text:{{ section.settings.text_color }};--gx-pt:{{ section.settings.padding_top }}px;--gx-pb:{{ section.settings.padding_bottom }}px;--gx-pt-mobile:{{ section.settings.padding_top }}px;--gx-pb-mobile:{{ section.settings.padding_bottom }}px;">
  <div class="genetix__inner"><div class="genetix-newsletter__layout"><div><p class="genetix__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="genetix__copy">{{ section.settings.text }}</div></div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="genetix-newsletter__form"><label class="visually-hidden" for="Newsletter-{{ section.id }}">Email address</label><input id="Newsletter-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email" required><button class="genetix__button" type="submit">{{ section.settings.button_label | escape }}</button></div>{% if form.posted_successfully? %}<p class="genetix-newsletter__message" role="status">Thanks for subscribing.</p>{% elsif form.errors %}<div class="genetix-newsletter__message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></div>
</section>
{% schema %}{"name":"GENETIX newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"JOIN THE FORMULA"},{"type":"text","id":"heading","label":"Heading","default":"Subscribe to our newsletter."},{"type":"richtext","id":"text","label":"Text","default":"<p>Product news, new releases, and the latest from GENETIX.</p>"},{"type":"text","id":"placeholder","label":"Email placeholder","default":"Your email address"},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"},{"type":"color","id":"background","label":"Background","default":"#eaf5fa"},{"type":"color","id":"text_color","label":"Text","default":"#173c48"},{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":100,"step":1,"unit":"px","default":52}],"presets":[{"name":"GENETIX newsletter"}]}{% endschema %}
