{% comment %}
  Merchant-composed featured product with a sticky media gallery and reusable content blocks.
  @example
  Choose a product, then add and arrange product content blocks in the theme editor.
{% endcomment %}

{{ 'genetix-custom-featured-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'genetix-featured-product.js' | asset_url }}" type="module"></script>

{% liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'GenetixCustomProductForm-' | append: section.id
%}

<section class="gxc-product" style="--gxc-bg:{{ section.settings.background }};--gxc-ink:{{ section.settings.text_color }};--gxc-media-bg:{{ section.settings.media_background }};--gxc-pt:{{ section.settings.padding_top }}px;--gxc-pb:{{ section.settings.padding_bottom }}px;">
  <div class="gxc-product__inner">
    <genetix-product class="gxc-product__component" data-section-id="{{ section.id }}" data-add-label="Add to bag" data-sold-out-label="Sold out" data-unavailable-label="Unavailable">
      {% if product != blank %}
        <div class="gxc-product__layout">
          <div class="gxc-product__gallery">
            {% if section.settings.gallery_label != blank %}<span class="gxc-product__gallery-label">{{ section.settings.gallery_label | escape }}</span>{% endif %}
            {% assign featured_media = product.featured_media %}
            <div class="gxc-product__main">
              {% if featured_media.preview_image %}
                {% capture main_product_image %}
                  {{ featured_media.preview_image | image_url: width: 1400 | image_tag: class: 'gxc-product__main-image', widths: '500, 700, 1000, 1400', sizes: '(min-width: 750px) 48vw, 100vw', alt: featured_media.alt | default: product.title | escape }}
                {% endcapture %}
                {{ main_product_image | replace: '<img ', '<img data-main-image="true" ' }}
              {% else %}<div class="gxc-product__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}
            </div>
            {% if product.media.size > 1 %}<div class="gxc-product__thumbs" aria-label="Product images">
              {% for media in product.media %}{% if media.preview_image %}<button class="gxc-product__thumb" type="button" data-media-src="{{ media.preview_image | image_url: width: 1400 }}" data-media-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show image {{ forloop.index }}" aria-current="{% if media.id == featured_media.id %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 140 | image_tag: widths: '70, 140', alt: '' }}</button>{% endif %}{% endfor %}
            </div>{% endif %}
          </div>
          <div class="gxc-product__details">
            {% form 'product', product, id: form_id, class: 'gxc-product__form' %}
              <input type="hidden" name="id" value="{{ variant.id }}" data-form-variant>
              {% for block in section.blocks %}
                {% unless block.type == 'buy_button' %}{% render 'genetix-custom-featured-product-block', block: block, product: product, section_id: section.id, product_form: form %}{% endunless %}
              {% endfor %}
              <div class="gxc-product__purchase">
                <div class="gxc-product__quantity"><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input type="number" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}" min="{{ variant.quantity_rule.min | default: 1 }}" step="{{ variant.quantity_rule.increment | default: 1 }}" {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %} data-quantity-input aria-label="Quantity"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div>
                <button class="gxc-product__add" type="submit" data-product-submit data-base-label="{{ section.settings.add_label | escape }}" {% unless variant.available %}disabled{% endunless %}><span data-button-label>{{ section.settings.add_label | escape }} — <span data-button-price>{{ variant.price | money }}</span></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
              </div>
              {% for block in section.blocks %}{% if block.type == 'buy_button' %}{% render 'genetix-custom-featured-product-block', block: block, product: product, section_id: section.id, product_form: form %}{% endif %}{% endfor %}
              <p class="gxc-product__error" data-error role="status" aria-live="polite"></p>
            {% endform %}
          </div>
        </div>
      {% else %}<p>Select a product in the section settings.</p>{% endif %}
    </genetix-product>
  </div>
</section>

{% schema %}
{
  "name": "Custom Featured",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "gallery_label", "label": "Gallery label", "default": "SKIN + SCALP MATRIX" },
    { "type": "text", "id": "add_label", "label": "Add button label", "default": "Add to bag" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#173c48" },
    { "type": "color", "id": "media_background", "label": "Gallery background", "default": "#eef6f9" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "THE DAILY ESSENTIAL" }, { "type": "range", "id": "font_size", "label": "Text size", "min": 8, "max": 20, "step": 1, "unit": "px", "default": 9 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "brand_image", "name": "Inline image", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "range", "id": "content_size", "label": "Content size", "min": 40, "max": 400, "step": 10, "unit": "px", "default": 180 }, { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" }] },
    { "type": "title", "name": "Product title", "settings": [{ "type": "range", "id": "font_size", "label": "Text size", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 34 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "meta", "name": "Product subtitle", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>2 fl oz / 59 ml · Skin + Scalp</p>" }, { "type": "range", "id": "font_size", "label": "Text size", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 12 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "price", "name": "Product price", "settings": [{ "type": "range", "id": "font_size", "label": "Text size", "min": 14, "max": 42, "step": 1, "unit": "px", "default": 24 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "description", "name": "Product description", "settings": [{ "type": "select", "id": "source", "label": "Description source", "options": [{ "value": "product", "label": "Product description" }, { "value": "custom", "label": "Custom description" }], "default": "product" }, { "type": "richtext", "id": "custom_text", "label": "Custom description", "default": "<p>Describe the formula, ingredients, and benefits.</p>" }, { "type": "image_picker", "id": "inline_image", "label": "Image for [image] token" }, { "type": "range", "id": "image_size", "label": "Inline image width", "min": 24, "max": 320, "step": 8, "unit": "px", "default": 120 }, { "type": "range", "id": "font_size", "label": "Text size", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 11 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "impact_metrics", "name": "Impact numbers", "settings": [{ "type": "header", "content": "Impact 1" }, { "type": "text", "id": "number_1", "label": "Number", "default": "2%" }, { "type": "text", "id": "label_1", "label": "Label", "default": "GHK-Cu" }, { "type": "header", "content": "Impact 2" }, { "type": "text", "id": "number_2", "label": "Number", "default": "6%" }, { "type": "text", "id": "label_2", "label": "Label", "default": "PAL-150" }, { "type": "header", "content": "Impact 3" }, { "type": "text", "id": "number_3", "label": "Number", "default": "3%" }, { "type": "text", "id": "label_3", "label": "Label", "default": "Niacinamide" }, { "type": "header", "content": "Impact 4" }, { "type": "text", "id": "number_4", "label": "Number", "default": "0.5%" }, { "type": "text", "id": "label_4", "label": "Label", "default": "PDRN+" }, { "type": "header", "content": "Impact 5" }, { "type": "text", "id": "number_5", "label": "Number" }, { "type": "text", "id": "label_5", "label": "Label" }, { "type": "header", "content": "Impact 6" }, { "type": "text", "id": "number_6", "label": "Number" }, { "type": "text", "id": "label_6", "label": "Label" }, { "type": "range", "id": "number_size", "label": "Number text size", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 18 }, { "type": "range", "id": "label_size", "label": "Label text size", "min": 8, "max": 20, "step": 1, "unit": "px", "default": 10 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "icon_text", "name": "Icon with text", "settings": [{ "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }, { "value": "check", "label": "Check" }], "default": "shield" }, { "type": "image_picker", "id": "custom_icon", "label": "Custom icon image" }, { "type": "text", "id": "text", "label": "Text", "default": "Secure checkout" }, { "type": "range", "id": "icon_size", "label": "Icon size", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 18 }, { "type": "range", "id": "text_size", "label": "Text size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 11 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "accordion", "name": "Collapsible content", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Formula & ingredients" }, { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add product details here.</p>" }, { "type": "range", "id": "font_size", "label": "Text size", "min": 8, "max": 22, "step": 1, "unit": "px", "default": 11 }, { "type": "color", "id": "color", "label": "Text color" }] },
    { "type": "buy_button", "name": "Buy now button", "settings": [] },
    { "type": "variant", "name": "Variant picker", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Choose an option" }, { "type": "range", "id": "font_size", "label": "Text size", "min": 8, "max": 22, "step": 1, "unit": "px", "default": 11 }, { "type": "color", "id": "color", "label": "Text color" }] }
  ],
  "presets": [{ "name": "Custom Featured", "blocks": [{ "type": "eyebrow" }, { "type": "brand_image" }, { "type": "title" }, { "type": "meta" }, { "type": "price" }, { "type": "description" }, { "type": "impact_metrics", "settings": { "number_1": "2%", "label_1": "GHK-Cu", "number_2": "6%", "label_2": "PAL-150", "number_3": "3%", "label_3": "Niacinamide", "number_4": "0.5%", "label_4": "PDRN+" } }, { "type": "icon_text", "settings": { "icon": "shield", "text": "Secure checkout" } }, { "type": "icon_text", "settings": { "icon": "truck", "text": "Free insured U.S. shipping" } }, { "type": "buy_button" }, { "type": "accordion" }, { "type": "accordion", "settings": { "heading": "Quality & clinical testing" } }, { "type": "accordion", "settings": { "heading": "Shipping & fulfillment" } }] }]
}
{% endschema %}
